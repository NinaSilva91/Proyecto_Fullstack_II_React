# .env.example: copia este archivo como ".env" (o ".env.local") y completa SOLO lo que necesites.
# ".env" / ".env.local" NO se suben a GitHub (está en .gitignore).

# MODO fs2-WEB: la tienda funciona con el backend fs2-api. Los usuarios entran
# con el formulario de correo/clave (Login/Register) y el backend valida contra
# AWS Cognito POR ELLOS: el navegador nunca se conecta directo a Cognito.
# Sin VITE_API_URL la tienda sigue funcionando en modo local (demo del navegador).

# --- Backend fs2-api ---
VITE_API_URL=http://localhost:8080/api
